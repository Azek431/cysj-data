# ============================================================
# .stignore — Syncthing 同步忽略规则
# 作用：告诉 Syncthing 哪些文件/文件夹不需要在设备间同步
# 注意：此文件只对当前设备生效，每台设备维护自己的副本
# 语法：支持 ? * ** 通配符，! 开头表示取消忽略
# ============================================================


# ============================================================
# 【Syncthing 自身文件】
# ============================================================

# .stignore 本身不同步，每台设备保持独立的忽略规则
# 如果同步了，A 设备的规则会覆盖 B 设备，造成混乱
.stignore

# Syncthing 删除文件夹后留下的残留标记，无意义
.stfolder.removed-*

# Syncthing 的历史版本存储目录（可能体积很大）
# 如果你需要文件历史版本功能，可以删掉这一行
.stversions/

# Syncthing 同步冲突文件（两台设备同时修改同一文件产生）
# 冲突文件应手动处理后删除，不需要同步到其他设备
*.sync-conflict-*


# ============================================================
# 【Node.js / pnpm 依赖】
# ============================================================

# npm/pnpm/yarn 安装的依赖包，体积通常几百 MB 到几 GB
# 换设备后执行 pnpm install 即可重新生成，完全不需要同步
node_modules/

# pnpm 的全局缓存目录（如果放在项目内的话）
.pnpm-store/

# pnpm 工作区锁文件的临时缓存
.pnpm-debug.log


# ============================================================
# 【VitePress / Vite 构建产物与缓存】
# ============================================================

# VitePress 构建输出目录，存放编译后的网站文件（HTML/JS/CSS）
# 执行 pnpm run docs:build 随时可以重新生成，绝对不需要同步
# 不排除此目录会导致 Syncthing 锁住文件，使构建失败（EPERM）
docs/.vitepress/dist/
.vitepress/dist/
dist/
build/

# VitePress / Vite 的本地编译缓存，加速二次构建用
# 换设备后会自动重建，不需要同步
docs/.vitepress/cache/
docs/.vitepress/.temp/
.vitepress/cache/
.vitepress/.temp/

# VitePress 本地预览服务的临时文件
site-dist/


# ============================================================
# 【日志文件】
# ============================================================

# 所有 .log 文件（Node.js、pnpm、系统产生的运行日志）
# 日志是本地运行记录，同步没有意义
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*


# ============================================================
# 【临时文件与备份残留】
# ============================================================

# 各种编辑器和程序产生的临时/备份文件
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo

# Python 字节码缓存
*.pyc
__pycache__/

# 图片编辑软件（如美图）产生的备份文件
*.jpg.hwbk
*.png.hwbk

# 本地备份目录（手动备份的残留，不应同步）
.backup/
backup/


# ============================================================
# 【操作系统产生的垃圾文件】
# ============================================================

# macOS 文件夹元数据（在 Windows 设备上毫无意义）
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows 缩略图缓存（在 macOS/Linux 上毫无意义）
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# Windows 回收站残留
$RECYCLE.BIN/


# ============================================================
# 【编辑器本地配置】
# ============================================================

# VSCode 本地工作区配置（插件推荐、调试配置等因人而异）
# 如果你希望多设备共享 VSCode 配置，可以删掉这一行
.vscode/

# JetBrains 系列（WebStorm、IDEA 等）的本地索引和缓存
.idea/

# Vim/Neovim 会话文件
*.vim
Session.vim


# ============================================================
# 【敏感配置与环境变量】
# ============================================================

# 环境变量文件，通常包含 API Key、数据库密码等敏感信息
# 强烈建议不要在任何地方同步这类文件
.env
.env.*
# 例外：示例模板文件可以同步（里面是假数据）
!.env.example

# 其他可能含敏感信息的本地配置文件
config.ini
secret.txt
*.local


# =========================
# Generated / cache files
# =========================

# =========================
# Syncthing conflict files
# =========================
*sync-conflict*
