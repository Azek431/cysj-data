# 每台设备使用自己的忽略规则，避免互相覆盖
.stignore

# Syncthing 版本/残留
.stfolder.removed-*
.stversions/

# 依赖目录：可重新安装，不需要备份
node_modules/
.pnpm-store/

# VitePress / Vite 缓存和构建产物：可重新生成
docs/.vitepress/cache/
docs/.vitepress/dist/
.vitepress/cache/
.vitepress/dist/
dist/
build/

# 日志和临时文件
logs/
*.log
*.tmp
*.temp
*.bak
*.old
*.orig

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 编辑器缓存/本地配置
.idea/
.vscode/

# 敏感配置：如果你确实想备份，可以删掉这一段
.env
.env.*
!.env.example
config.ini
secret.txt
*.local

# 本地备份残留
.backup/
backup/
*.jpg.hwbk
