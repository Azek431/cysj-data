# =========================================================
# 【依赖目录】
# 换设备后执行 pnpm install 重新生成，体积巨大不应提交
# =========================================================
node_modules/
.pnpm-store/
.pnpm-debug.log


# =========================================================
# 【VitePress / Vite 构建产物与缓存】
#
# 只忽略生成物，不忽略源文件目录本身
# config.*、theme/、public/ 等源文件会被正常追踪
# =========================================================

# 构建输出：pnpm run docs:build 生成，随时可重建，不提交
docs/.vitepress/dist/
.vitepress/dist/
dist/
build/
site-dist/
cysjdocs-dist/

# 编译缓存：本地加速用，不提交
docs/.vitepress/cache/
docs/.vitepress/.temp/
.vitepress/cache/
.vitepress/.temp/


# =========================================================
# 【日志文件】
# 本地运行记录，提交无意义
# =========================================================
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*


# =========================================================
# 【环境变量与敏感配置】
# 包含 API Key、密码等敏感信息，绝对不能提交
# 如需共享配置模板，使用 .env.example（已排除在外）
# =========================================================
.env
.env.*
!.env.example
config.ini
secret.txt
*.local


# =========================================================
# 【Syncthing 相关文件】
#
# .stfolder   — Syncthing 标记目录存在的空目录，无内容
# .stversions — 文件历史版本，体积大且与 git 历史重复
# .stfolder.removed-* — 旧标记残留，无意义
# .sync-conflict-* — 两台设备同时改同一文件产生的冲突副本
#                    冲突文件应手动处理后删除，不应进入版本库
# docs/_conflicts/ — 本项目存放冲突文件的自定义目录
# =========================================================
.stfolder/
.stfolder.removed-*
.stversions/
.sync/
.sync-conflict-*
*.sync-conflict-*
docs/_conflicts/


# =========================================================
# 【自动部署脚本产生的临时文件】
# auto-deploy.sh 在服务器本地生成，记录上次构建的文件哈希
# 这个文件是服务器运行状态，不属于源代码，不应提交
# =========================================================
.last_docs_hash


# =========================================================
# 【操作系统垃圾文件】
# macOS、Windows 自动生成的系统元数据，对其他设备无意义
# =========================================================
.DS_Store
Thumbs.db
desktop.ini


# =========================================================
# 【编辑器本地配置】
# 因人而异的本地设置，不强制同步给协作者
# 如果你希望共享 VSCode 推荐插件等配置，可删除 .vscode/ 这行
# =========================================================
.vscode/
.idea/


# =========================================================
# 【临时文件与备份残留】
# 各类工具产生的中间文件，无提交价值
# =========================================================
.backup/
backup/
*.bak
*.tmp
*.temp
*.old
*.orig

# Python 字节码与缓存目录（运行 .py 脚本后自动生成）
*.pyc
__pycache__/

# 图片编辑软件备份（如美图秀秀等）
*.jpg.hwbk
*.png.hwbk


# =========================================================
# 【通用缓存目录】
# =========================================================
.cache/
.temp/


# =========================
# Syncthing conflict files
# =========================
*.sync-conflict-*
*sync-conflict*
*.tmp
*.bak
*.old
