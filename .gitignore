# =========================================================
# 创游世界资料库 / VitePress 文档站 .gitignore
# =========================================================
#
# 设计原则：
# 1. Git 只保存“源文件”和“必须长期维护的资料”
# 2. 不保存依赖目录、构建产物、缓存、日志、临时文件
# 3. 不保存 API Key、账号密码、本地配置等敏感信息
# 4. 不保存 Syncthing 冲突副本、备份残留、系统垃圾文件
# 5. 不忽略 docs/、docs/public/、资料截图等真正有价值的资料源
#
# 注意：
# .gitignore 只能阻止“未来新文件”被加入 Git。
# 如果某些文件已经被 Git 跟踪，需要使用：
# git rm -r --cached <路径>
# 才能从版本库索引中移除，但保留本地文件。
# =========================================================


# =========================================================
# 1. Node / pnpm 依赖目录
# =========================================================
#
# node_modules 和 pnpm store 都可以通过 pnpm install 重新生成。
# 这些目录体积极大、文件数量极多，绝对不应提交。
#
# 注意：
# pnpm-lock.yaml 不要忽略，它是依赖锁定文件，应该提交。
# =========================================================

node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz


# =========================================================
# 2. 非本项目包管理器锁文件
# =========================================================
#
# 本项目主要使用 pnpm。
# 为避免误用 npm / yarn / bun 生成额外锁文件，这里忽略它们。
#
# 如果未来项目明确切换包管理器，再按需要调整。
# =========================================================

package-lock.json
yarn.lock
bun.lockb
bun.lock


# =========================================================
# 3. VitePress / Vite 构建产物
# =========================================================
#
# 这些都是 pnpm run docs:build 或部署流程生成的输出。
# 它们可以随时重新构建，不属于源代码。
#
# 重要：
# 不要忽略 docs/.vitepress/ 整个目录。
# 因为 config.mts、theme、components、styles、public 等都是源文件。
# =========================================================

docs/.vitepress/dist/
.vitepress/dist/
dist/
build/
site-dist/
cysjdocs-dist/


# =========================================================
# 4. VitePress / Vite / 工具缓存
# =========================================================
#
# 这些目录只用于本地加速或临时编译。
# 不同设备、不同系统生成内容不同，提交后只会污染仓库。
# =========================================================

docs/.vitepress/cache/
docs/.vitepress/.temp/
.vitepress/cache/
.vitepress/.temp/
.cache/
.temp/
.tmp/


# =========================================================
# 5. 自动生成文件
# =========================================================
#
# 如果某些文件由脚本自动生成，并且项目约定“不追踪生成物”，
# 可以放在这里。
#
# 注意：
# 如果你的项目决定追踪某个生成文件，就不要放进这里。
# =========================================================

docs/.vitepress/sidebar.generated.ts


# =========================================================
# 6. 日志文件
# =========================================================
#
# 日志用于本地排错，不属于项目内容。
# =========================================================

logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*


# =========================================================
# 7. 环境变量与敏感配置
# =========================================================
#
# 这里可能包含：
# - API Key
# - Token
# - 密码
# - 代理地址
# - 数据库连接信息
# - 私人部署配置
#
# .env.example 是模板文件，可以提交，所以用 ! 保留。
# =========================================================

.env
.env.*
!.env.example

*.local
config.local.*
config.private.*
secret.*
secrets.*
*.secret
*.key
*.pem
*.p12
*.pfx


# =========================================================
# 8. DeepSeek-TUI / AI Agent 本地运行文件
# =========================================================
#
# 如果你以后在项目里放 AI 工作流，建议：
# - .ai/PROJECT_RULES.md 可以提交
# - .ai/prompts/ 可以提交
# - .ai/reports/ 不提交，因为是本地运行报告
# - .ai/cache/、.ai/tmp/、.ai/secrets/ 不提交
#
# 注意：
# 全局 DeepSeek 配置一般在 ~/.deepseek，不在项目里。
# 如果误放到项目里，也不要提交。
# =========================================================

.ai/reports/
.ai/cache/
.ai/tmp/
.ai/temp/
.ai/secrets/
.ai/tool_outputs/

.deepseek/
.claude/
.aider*
.continue/
.roo/


# =========================================================
# 9. Syncthing 相关文件
# =========================================================
#
# .stfolder：
# Syncthing 用来标记同步目录的空文件夹，不属于项目。
#
# .stversions：
# Syncthing 文件历史版本目录，体积可能非常大。
#
# .sync-conflict-*：
# 多设备同时修改产生的冲突副本，必须人工处理，不应提交。
#
# 强烈建议：
# 不要用 Syncthing 同步 .git 目录。
# 每台设备应该单独 git clone，通过 GitHub/Gitee 同步代码。
# =========================================================

.stfolder/
.stfolder.removed-*
.stversions/
.sync/
.stignore

.sync-conflict-*
*.sync-conflict-*
*sync-conflict*
docs/_conflicts/


# =========================================================
# 10. 本地备份 / 清理快照 / 临时副本
# =========================================================
#
# 这些通常来自手动备份、脚本备份、AI 修改前备份、编辑器残留。
# 比如：
# docs/.vitepress.bak.20260517-xxxx
# docs/index.md.bak.20260517-xxxx
# xxx.bak
# xxx.tmp
# xxx.old
# =========================================================

.backup/
backup/
backups/

*.bak
*.bak.*
*.backup
*.backup.*
*.tmp
*.temp
*.old
*.orig
*.orig.*
*.swp
*.swo
*~

docs/.vitepress.bak.*/
docs/index.md.bak.*


# =========================================================
# 11. 操作系统自动生成文件
# =========================================================
#
# Windows / macOS 会自动生成这些元数据文件。
# 它们对文档站没有意义。
# =========================================================

.DS_Store
.AppleDouble
.LSOverride
Icon?

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/


# =========================================================
# 12. 编辑器 / IDE 本地配置
# =========================================================
#
# 默认忽略个人编辑器配置。
#
# 如果你未来想共享 VSCode 推荐插件，可以改成：
# .vscode/*
# !.vscode/extensions.json
# !.vscode/settings.json
# =========================================================

.vscode/
.idea/
*.code-workspace


# =========================================================
# 13. Python 缓存
# =========================================================
#
# 项目脚本或 OCR/处理工具可能会运行 Python。
# 这些缓存不用提交。
# =========================================================

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/


# =========================================================
# 14. 图片编辑软件 / 截图工具备份
# =========================================================
#
# 注意：
# 不要忽略 *.jpg、*.png、*.webp。
# 因为你的项目里有 OCR 截图、Logo、文档图片等重要资料。
#
# 这里只忽略“图片软件生成的备份文件”。
# =========================================================

*.jpg.hwbk
*.jpeg.hwbk
*.png.hwbk
*.webp.hwbk
*.psd.tmp
*.kra~


# =========================================================
# 15. 压缩包 / 视频 / 大型临时资料
# =========================================================
#
# 压缩包和视频通常不适合直接提交到 Git。
# 如果确实需要发布，建议放到：
# - GitHub Release
# - Gitee Release
# - 网盘
# - 对象存储
# - Git LFS
#
# 注意：
# 不忽略 PDF，因为文档资料中可能确实需要 PDF 原件。
# 如果未来 PDF 很大，再单独迁移到 LFS 或外部存储。
# =========================================================

*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv


# =========================================================
# 16. 自动部署 / 服务器本地状态文件
# =========================================================
#
# 这些文件记录部署状态或构建缓存，只属于本地/服务器。
# =========================================================

.last_docs_hash
.deploy-cache/
.deploy-tmp/
.deploy-temp/


# =========================================================
# 17. Git 清理 / pack 中断备份目录
# =========================================================
#
# 你之前清理 .git 时创建过这类目录。
# 正常情况下它们在 .git 内部，不会被 Git 跟踪。
# 这里写上是为了防止误复制到项目根目录后被提交。
# =========================================================

pack-garbage-backup-*/
pack-interrupt-backup-*/


# =========================================================
# 18. 不要在这里忽略的内容
# =========================================================
#
# 以下内容虽然可能体积较大，但目前不建议直接忽略：
#
# - docs/
#   文档源文件，必须追踪。
#
# - docs/public/
#   VitePress 静态资源源目录，里面的 robots.txt、llms.txt、_headers、
#   logo、图片等可能是站点必须文件。
#
# - 资料/官方教程文档截图/
#   这是 OCR 和证据链相关资料，是否迁移到 Git LFS 或外部存储，
#   应该单独规划，不建议用 .gitignore 直接屏蔽。
#
# - pnpm-lock.yaml
#   依赖锁定文件，建议提交。
#
# =========================================================

# Local debug logs and generated build output
/*tmp_logcat*.txt
/build.log
/.verify-*.log
/dist/
/.astro/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
